#version 450

#include "dequant_head.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_q1_0_g128 data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};

void main() {
    // Each workgroup dequantizes 32 blocks (4096 elements). Eight threads
    // share one block; each thread decodes 16 elements (4 packed bytes).
    const uint ib = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x / 8;
    const uint tid = gl_LocalInvocationID.x % 8;

    if (ib >= p.nel / 128) {
        return;
    }

    const float d = float(data_a[ib].d);

    const uint b_idx = 128*ib + 16*tid;
    const uint q_idx = 4*tid;

    // ternary: code c in {0,1,2}, weight = d * (c - 1)
    [[unroll]] for (uint l = 0; l < 4; ++l) {
        const uint vui = uint(data_a[ib].qs[q_idx + l]);
        data_b[b_idx + 4*l    ] = D_TYPE(d * (float(vui       & 3) - 1.0f));
        data_b[b_idx + 4*l + 1] = D_TYPE(d * (float((vui >> 2) & 3) - 1.0f));
        data_b[b_idx + 4*l + 2] = D_TYPE(d * (float((vui >> 4) & 3) - 1.0f));
        data_b[b_idx + 4*l + 3] = D_TYPE(d * (float( vui >> 6     ) - 1.0f));
    }
}
